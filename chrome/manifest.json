{
  "manifest_version": 3,
  "name": "Typefall",
  "version": "0.1.3",
  "description": "Snow, stardust and Christmas fireworks that fall across the page while you type.",
  "permissions": ["storage", "activeTab"],
  "action": { "default_popup": "popup.html", "default_title": "Typefall" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["typefall-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
